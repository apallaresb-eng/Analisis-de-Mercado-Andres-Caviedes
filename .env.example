# Copie este archivo como .env y rellene con los datos de SU proyecto de Supabase.
# Panel de Supabase > Project Settings > API

# Estos dos valores son PÚBLICOS por diseño: viajan al navegador.
# Lo que protege los datos es Row Level Security en PostgreSQL, no ocultar esta clave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# NO ponga aquí la clave service_role.
# Esa clave salta TODAS las políticas de seguridad. Va únicamente como variable
# de entorno cifrada en Cloudflare Pages, con el nombre SUPABASE_SERVICE_ROLE_KEY,
# y la carga usted directamente en el panel de Cloudflare.
# ---------------------------------------------------------------------------
